\deqn{D_{ij \leftarrow kl}(h) = \frac{\sum_q A^{cum}_q[i,k]^2 \cdot B^{cum}_q[j,l]^2}{\sum_q \|A^{cum}_q[i,\cdot]\|_2^2 \|B^{cum}_q[j,\cdot]\|_2^2}.}

